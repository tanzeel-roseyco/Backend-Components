# Backend Components Library
# Configuration Template
# Copy to .env and fill with your actual values

# ============================================================================
# DATABASE & STORAGE
# ============================================================================

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# PostgreSQL/Prisma
DATABASE_URL=postgresql://user:password@localhost:5432/database_name

# Redis (for caching, sessions, rate limiting)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=optional-password

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================

# Cookie & JWT Configuration
AUTH_COOKIE_NAME=__session
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_HTTPONLY=true
AUTH_COOKIE_SAMESITE=Strict
AUTH_TOKEN_EXPIRY_MINUTES=1440
AUTH_SECRET_KEY=your-secret-key-min-32-chars-here
AUTH_STORAGE_BACKEND=redis

# Rate Limiting
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_LOCKOUT_MINUTES=15
RATE_LIMIT_RESET_HOURS=24
RATE_LIMIT_STORAGE_BACKEND=redis
TRUST_PROXY_HEADERS=true

# ============================================================================
# THIRD-PARTY INTEGRATIONS
# ============================================================================

# Email Services
RESEND_API_KEY=re_your-resend-key-here
SENDGRID_API_KEY=SG.your-sendgrid-key-here
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
LEAD_OWNER_EMAIL=admin@example.com

# Email List Management
CONVERTKIT_API_KEY=your-convertkit-api-key
CONVERTKIT_API_SECRET=your-convertkit-secret
CONVERTKIT_WEBHOOK_SECRET=your-convertkit-webhook-secret

# Google APIs
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_KEY=path/to/service-account-key.json

# Crypto Trading APIs
BYBIT_API_KEY=your-bybit-api-key
BYBIT_API_SECRET=your-bybit-api-secret
BINANCE_API_KEY=your-binance-api-key
BINANCE_API_SECRET=your-binance-api-secret

# LLM Providers
OPENAI_API_KEY=sk-your-openai-key
GROQ_API_KEY=gsk_your-groq-key
GEMINI_API_KEY=your-gemini-api-key
LLM_PRIMARY_PROVIDER=groq
LLM_FALLBACK_PROVIDER=openai

# ============================================================================
# LEAD CAPTURE & SPAM DETECTION
# ============================================================================

LEAD_STORAGE_BACKEND=supabase
SPAM_DETECTION_ENABLED=true
HONEYPOT_FIELD_NAME=company_website
RATE_LIMIT_LEADS_PER_IP_PER_HOUR=10
MESSAGE_QUEUE_BACKEND=bull
MESSAGE_QUEUE_REDIS_URL=redis://localhost:6379

# ============================================================================
# WEBHOOKS & SECURITY
# ============================================================================

CALENDLY_WEBHOOK_SECRET=your-calendly-secret
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-secret
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret
ADMIN_SECRET=your-admin-secret-min-32-chars

# ============================================================================
# FEATURE FLAGS & CONFIGURATION
# ============================================================================

NODE_ENV=development
ENVIRONMENT=development
DEBUG=false
ENABLE_ANALYTICS=true
ENABLE_ERROR_REPORTING=false
ENABLE_CACHING=true
CACHE_TTL_SECONDS=3600
ENABLE_COMPRESSION=true

# ============================================================================
# INFRASTRUCTURE & DEPLOYMENT
# ============================================================================

# Application
APP_NAME=backend-components
APP_VERSION=1.0.0
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ============================================================================
# PERFORMANCE & LIMITS
# ============================================================================

REQUEST_TIMEOUT_SECONDS=30
MAX_REQUEST_SIZE=10mb
MAX_JSON_PAYLOAD_SIZE=1mb
MAX_RETRIES=3
BACKOFF_MULTIPLIER=2
BACKOFF_INITIAL_DELAY_MS=1000

# Batch Processing
MAX_BATCH_SIZE=500
MAX_CONCURRENT_REQUESTS=10
RATE_LIMIT_PER_SECOND=100

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================

# Datadog / NewRelic / etc
DATADOG_API_KEY=optional
DATADOG_APP_KEY=optional

# Uptime/Health Check
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL_SECONDS=60

# ============================================================================
# NOTES
# ============================================================================
#
# 1. Never commit this file with real values to git
# 2. Use a secrets manager (Vault, AWS Secrets Manager, etc.) in production
# 3. Rotate secrets quarterly minimum
# 4. Enable HTTPS in production
# 5. Use environment-specific configs (dev.env, staging.env, prod.env)
# 6. Audit who has access to secrets
# 7. Log secret access for security monitoring
# 8. Never log actual secret values
#
