{
  "name": "@backend-components/typescript",
  "version": "1.0.0",
  "description": "TypeScript/Node.js implementations of reusable backend components",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    },
    "./auth/portable-auth-core": {
      "types": "./dist/auth/portable-auth-core.d.ts",
      "require": "./dist/auth/portable-auth-core.js"
    },
    "./business-logic/abandoned-cart-recovery": {
      "types": "./dist/business-logic/abandoned-cart-recovery.d.ts",
      "require": "./dist/business-logic/abandoned-cart-recovery.js"
    },
    "./business-logic/lead-sequence-engine": {
      "types": "./dist/business-logic/lead-sequence-engine.d.ts",
      "require": "./dist/business-logic/lead-sequence-engine.js"
    },
    "./business-logic/quote-document-workflow": {
      "types": "./dist/business-logic/quote-document-workflow.d.ts",
      "require": "./dist/business-logic/quote-document-workflow.js"
    },
    "./business-logic/signed-document-processor": {
      "types": "./dist/business-logic/signed-document-processor.d.ts",
      "require": "./dist/business-logic/signed-document-processor.js"
    },
    "./infrastructure/agent-action-spool": {
      "types": "./dist/infrastructure/agent-action-spool.d.ts",
      "require": "./dist/infrastructure/agent-action-spool.js"
    },
    "./infrastructure/ai-cost-guard": {
      "types": "./dist/infrastructure/ai-cost-guard.d.ts",
      "require": "./dist/infrastructure/ai-cost-guard.js"
    },
    "./infrastructure/resumable-file-transfer": {
      "types": "./dist/infrastructure/resumable-file-transfer.d.ts",
      "require": "./dist/infrastructure/resumable-file-transfer.js"
    },
    "./infrastructure/ssrf-safe-downloader": {
      "types": "./dist/infrastructure/ssrf-safe-downloader.d.ts",
      "require": "./dist/infrastructure/ssrf-safe-downloader.js"
    },
    "./infrastructure/workflow-lease": {
      "types": "./dist/infrastructure/workflow-lease.d.ts",
      "require": "./dist/infrastructure/workflow-lease.js"
    },
    "./integrations/docusign-client": {
      "types": "./dist/integrations/docusign-client.d.ts",
      "require": "./dist/integrations/docusign-client.js"
    },
    "./integrations/dotloop-client": {
      "types": "./dist/integrations/dotloop-client.d.ts",
      "require": "./dist/integrations/dotloop-client.js"
    },
    "./integrations/google-workspace-rest": {
      "types": "./dist/integrations/google-workspace-rest.d.ts",
      "require": "./dist/integrations/google-workspace-rest.js"
    },
    "./integrations/gotenberg-client": {
      "types": "./dist/integrations/gotenberg-client.d.ts",
      "require": "./dist/integrations/gotenberg-client.js"
    },
    "./integrations/stripe-commerce": {
      "types": "./dist/integrations/stripe-commerce.d.ts",
      "require": "./dist/integrations/stripe-commerce.js"
    },
    "./integrations/telegram-intake": {
      "types": "./dist/integrations/telegram-intake.d.ts",
      "require": "./dist/integrations/telegram-intake.js"
    },
    "./integrations/twilio-voice": {
      "types": "./dist/integrations/twilio-voice.d.ts",
      "require": "./dist/integrations/twilio-voice.js"
    },
    "./utilities/secret-redaction": {
      "types": "./dist/utilities/secret-redaction.d.ts",
      "require": "./dist/utilities/secret-redaction.js"
    },
    "./utilities/spam-submission-guard": {
      "types": "./dist/utilities/spam-submission-guard.d.ts",
      "require": "./dist/utilities/spam-submission-guard.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.core.json",
    "typecheck": "tsc -p tsconfig.core.json --noEmit",
    "dev": "tsc -p tsconfig.core.json --watch",
    "test:core": "rm -rf .test-dist && tsc -p tsconfig.core.json --outDir .test-dist && NODE_ENV=test node --test utilities/*.test.js auth/*.test.js infrastructure/*.test.js integrations/*.test.js business-logic/*.test.js",
    "test:package": "npm run build && node -e \"const library = require('.'); if (Object.keys(library).length !== 19) throw new Error('package entry point is incomplete')\"",
    "verify": "npm run typecheck && npm run lint && npm run test:core && npm run test:package && npm audit --audit-level=high",
    "prepack": "npm run verify",
    "lint": "eslint $(tr -d '\\r' < core-files.txt | tr '\\n' ' ')",
    "format": "prettier --write $(tr -d '\\r' < core-files.txt | tr '\\n' ' ')"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "backend",
    "components",
    "auth",
    "database",
    "middleware",
    "integrations",
    "supabase",
    "typescript"
  ],
  "author": "TeamRoseyCo",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
