{
  "name": "@backend-components/typescript",
  "version": "1.0.0",
  "description": "TypeScript/Node.js implementations of reusable backend components",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    },
    "./auth/portable-auth-core": {
      "types": "./dist/auth/portable-auth-core.d.ts",
      "require": "./dist/auth/portable-auth-core.js"
    },
    "./business-logic/*": {
      "types": "./dist/business-logic/*.d.ts",
      "require": "./dist/business-logic/*.js"
    },
    "./infrastructure/*": {
      "types": "./dist/infrastructure/*.d.ts",
      "require": "./dist/infrastructure/*.js"
    },
    "./integrations/*": {
      "types": "./dist/integrations/*.d.ts",
      "require": "./dist/integrations/*.js"
    },
    "./utilities/*": {
      "types": "./dist/utilities/*.d.ts",
      "require": "./dist/utilities/*.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.core.json",
    "typecheck": "tsc -p tsconfig.core.json --noEmit",
    "dev": "tsc -p tsconfig.core.json --watch",
    "test:core": "rm -rf .test-dist && tsc -p tsconfig.core.json --outDir .test-dist && NODE_ENV=test node --test utilities/*.test.js auth/*.test.js infrastructure/*.test.js integrations/*.test.js business-logic/*.test.js",
    "test:package": "npm run build && node -e \"const library = require('.'); if (Object.keys(library).length !== 19) throw new Error('package entry point is incomplete')\"",
    "verify": "npm run typecheck && npm run lint && npm run test:core && npm run test:package && npm audit --audit-level=high",
    "prepack": "npm run verify",
    "lint": "eslint $(tr -d '\\r' < core-files.txt | tr '\\n' ' ')",
    "format": "prettier --write $(tr -d '\\r' < core-files.txt | tr '\\n' ' ')"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "backend",
    "components",
    "auth",
    "database",
    "middleware",
    "integrations",
    "supabase",
    "typescript"
  ],
  "author": "TeamRoseyCo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanzeel-roseyco/Backend-Components.git",
    "directory": "typescript"
  },
  "bugs": {
    "url": "https://github.com/tanzeel-roseyco/Backend-Components/issues"
  },
  "homepage": "https://github.com/tanzeel-roseyco/Backend-Components#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
